backend/models/
backend/cache/
backend/uploads/

# ── Runtime state / secrets ──────────────────────────────────────────────
backend/.env
backend/.last_engine
backend/.last_asr_model
*.log

# ── Frontend ─────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── OS / editors ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
